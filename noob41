#include <iostream>
using namespace std;

int main() {
    int a;
    int b[100];
    int c=0;
    for(int i=0;i<100;i++)
    {
        cin>>a;
        if(a==0)
        break;
        else
        {
            b[i]=a;
            c+=1;
        }
    }
    for(int i=c-1;i>=0;i--)
    {
        cout<<b[i]<<" ";
    }
}
