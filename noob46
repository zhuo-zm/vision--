#include <iostream>
using namespace std;

int main() {
    int n,k,m;
    cin>>n>>k>>m;
    int a[n];
    for(int i=0;i<n;i++)
    {
        a[i]=0;
    }
    int b=0,c=0;
    for(int i=k;b!=n-1;i=(i+1)%n)
    {
        if(a[i]==1)
        {
            continue;
        }
        else {
        c++;
        if(c==m)
        {
            b++;
            a[i]=1;
            c=0;
        }
        }
        
    }
    for(int i=0;i<n;i++)
    {
        if(a[i]==0)
        cout<<i;
    }
}
