#include <iostream>
using namespace std;

int main() {
    int l,m;
    cin>>l>>m;
    int a[10000]={0};
    for(int i=1;i<=m;i++)
    {
        int b,c;
        cin>>b>>c;
        for(int j=b;j<=c;j++)
        {
            a[j]=1;
        }
    }
    int he=l+1;
    for(int i=0;i<=l;i++)
    {
        if(a[i]==1)
        he--;
    }
    cout<<he;
}
