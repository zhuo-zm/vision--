#include <iostream>
using namespace std;
int main() {
    int t;
    cin>>t;
    for(int j=0;j<t;j++)
{
    string a;
    int b[4];
    int c=0,d=605,c1=0,d1=0;
    for(int i=0;i<=3;i++)
    {
        cin>>a;
        b[i]=a.size();
        c=max(c,b[i]);
        d=min(d,b[i]);
    }
    for(int m1=0;m1<4;m1++)
    {
        if(b[m1]==c)
            c1++;
        if(b[m1]==d)
            d1++;
    }
    if(d1==1&&c1!=1)
        {     
            for(int m2=0;m2<4;m2++)
            {
                if(d==b[m2])
                    cout<<char(m2+'A')<<endl;
            }
        }
    else if(c1==1&&d1!=1)
    {
        for(int m3=0;m3<4;m3++)
        {
            if(c==b[m3])
                cout<<char(m3+'A')<<endl;
        }
    }
    else
        cout<<'C'<<endl;
}
}
