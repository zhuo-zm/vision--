#include <iostream>
using namespace std;

int main() {
    int a;
    cin>>a;
    int b[a];
    int c=0;
    for(int i=0;i<a;i++)
    {
        cin>>b[i];
        for(int j=0;j<=i;j++)
        {
            if(b[j]<b[i])
            c++;
            else
             continue;
        }
        cout<<c<<" ";
        c=0;
    }
}
