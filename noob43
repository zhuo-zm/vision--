#include <iomanip>
#include <iostream>
using namespace std;

int main() {
    int m;
    cin>>m;
    for(int j=0;j<m;j++)
    {
    int a;
    cin>>a;
    int b[a];
    int c1=0,c2=1e9;
    double d=0,e=0;
    for(int i=0;i<a;i++)
    {
        cin>>b[i];
        d+=b[i];
    }
    for(int i=0;i<a;i++)
    {
        c1=max(b[i],c1);
        c2=min(b[i],c2);
        e+=(b[i]-d/a)*(b[i]-d/a);
    }
    cout<<c1-c2<<" "<<fixed<<setprecision(3)<<e/a<<endl;
    d=0;
    e=0;
    }
}
