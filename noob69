#include <iostream>
using namespace std;
struct stu{
    string name;
    int c1,c2,c3;
    int t;
    void put(string b,int b1,int b2,int b3)
    {
        name=b;
        c1=b1;
        c2=b2;
        c3=b3;
        t=c1+c2+c3;
    }
    void show()
    {
        cout<<name<<" "<<c1<<" "<<c2<<" "<<c3;
    }
}num[1000];
int main() {
    int n;
    cin>>n;
    string b;
    int b1,b2,b3;
    int a=0;
    for(int i=0;i<n;i++)
    {
        cin>>b>>b1>>b2>>b3;
        num[i].put(b,b1,b2,b3);
        a=max(a,num[i].t);
    }
    for(int i=0;i<n;i++)
    {
        if(num[i].t==a)
        {
            num[i].show();
            break;
        }
    }
}
