#include <iostream>
#include <vector>
using namespace std;

int main() {
    int a,b;
    cin>>a>>b;
    const int mod=1e9+7;
    //vector<vector<long int>> c(a+1,vector<long int>(b+1,0));
    long int c[a][b];
    c[0][0]=1;
    for(int i=1;i<a;i++)
    {
        c[i][0]=c[i-1][0];
    }
    for(int i=1;i<b;i++)
    {
        c[0][i]=c[0][i-1];
    }
    for(int i=1;i<a;i++)
    {
        for(int j=1;j<b;j++)
        {
            c[i][j]=(c[i][j-1]+c[i-1][j])%mod;
        }
    }
    cout<<c[a-1][b-1];
    return 0;
}
