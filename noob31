#include <iostream>
using namespace std;

int main() {
    int a;
    cin>>a;
    int b[a];
    int j;
    for(int i=0;i<a;i++)
    {
        cin>>b[i];
        for(j=2;j<=b[i];j++)
        {
            if(b[i]%j==0)
            break;
        }
        if(j==b[i])
        cout<<"Yes"<<endl;
        else
         cout<<"No"<<endl;
    }
}
