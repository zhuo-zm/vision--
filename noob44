#include <iostream>
using namespace std;

int main() {
    int a;
    cin>>a;
    
    
    
    for(int i=1;i<=a;i++)
    {
        int n,k;
        cin>>n>>k;
        int b[n];
        int S=0,cnt=0;
        for(int j=0;j<n;j++)
        {
            cin>>b[j];
        }
        for(int j=0;j<n;j++)
        {
            if(b[j]>=k)
            S+=b[j];
            if(b[j]==0&&S>=1)
            {
                S--;
                cnt++;
            }
        }
        cout<<cnt<<endl;
    }
}
